{
  "name": "@tager/admin-dynamic-field",
  "version": "1.1.6",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/main.d.ts",
  "exports": {
    "./css": "./dist/style.css",
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "vite build",
    "build:package": "yarn build:js && yarn emit-declarations",
    "emit-declarations": "vue-tsc --project tsconfig.json --emitDeclarationOnly",
    "tager:update": "yarn upgrade --latest --scope @tager",
    "yalc:clean": "yalc remove --all",
    "prepare": "yarn build:package",
    "storybook": "start-storybook --port 3000",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "dependencies": {
    "lodash.kebabcase": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-essentials": "^6.5.15",
    "@storybook/addon-links": "^6.5.15",
    "@storybook/builder-webpack5": "^6.5.15",
    "@storybook/manager-webpack5": "^6.5.15",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/vue3": "^6.5.15",
    "@tager/admin-services": "^1.1.11",
    "@tager/admin-ui": "^1.0.54",
    "@types/lodash.kebabcase": "^4.1.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^7.1.0",
    "core-js": "^3.22.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "msw": "^0.39.2",
    "msw-storybook-addon": "^1.6.3",
    "pinia": "^2.0.18",
    "prettier": "^3.9.10",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "storybook-vue3-router": "^2.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue": "3.2.33",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.0.14",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@tager/admin-services": "^1.0.0",
    "@tager/admin-ui": "^1.0.0",
    "vue": "^3.2.33",
    "vue-router": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
